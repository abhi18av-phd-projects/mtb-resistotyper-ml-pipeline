/*
 * mtb-resistotyper-ml pipeline configuration.
 */

params {
    // --- inputs -------------------------------------------------------------
    cryptic_src   = null      // cryptic-tables-vX.Y.Z/ — builds the database
    db            = null      // or reuse one; a local path or an s3:// URI
    // An experiment file sets `db_name` (e.g. cryptic-v2.1.2.duckdb) and the
    // site supplies the rest. A params file that embeds a bucket path pins the
    // experiment to one deployment, and a committed experiment exists so that
    // somebody else can re-run it.
    db_name       = null
    outdir        = 'results'

    // --- abc cluster storage (ADR-0060 taxonomy) ---------------------------
    // A project is a PREFIX in its group's bucket, never a bucket of its own:
    // the shared pipeline cache and the workbench home are both keyed on the
    // GROUP bucket, so a project bucket silently opts out of both.
    // From the environment, so the committed config names no site. See
    // site.env.example. The default is a placeholder that will not resolve,
    // which is deliberate: a run that silently used somebody else's bucket
    // because a variable was unset would be worse than one that fails.
    group_bucket  = System.getenv('MTB_GROUP_BUCKET') ?: 'su-example-group'
    pipeline_id   = 'mtb-resistotyper-ml'
    user_prefix   = 'users/abhi'

    // Curated, read-only, shared by the group.
    references    = "s3://${params.group_bucket}/references"
    // Group-shared and runner-only: the resume session UUID keys off this path,
    // so another member re-running the same pipeline reuses this cache.
    pipeline_root = "s3://${params.group_bucket}/pipelines/${params.pipeline_id}"
    // Visible in the workbench as ~/abc/me/<group>/results/
    user_results  = "s3://${params.group_bucket}/${params.user_prefix}/results"
    project_root  = "${projectDir}/.."
    // The stack is split across three mutually exclusive environments: econml
    // and dowhy pin numpy 1.x while this project's H2O environment is numpy 2.x.
    // One interpreter cannot serve both, so each process gets the one that has
    // its dependencies -- locally a venv path, in a container a plain `python`.
    python        = "${projectDir}/../.pixi/envs/default/bin/python"
    python_causal = "${System.getenv('HOME')}/.cache/mtb-causal-venv/bin/python"
    python_h2o    = "${projectDir}/../.pixi/envs/default/bin/python"

    // Image tag. The analysis code ships INSIDE the image, so this pins the
    // analysis version as surely as the git revision pins the workflow.
    // A real registry, not a host-local naming convention.
    //
    // That convention was not merely inconvenient: Nomad's docker driver
    // defaults to gc.image = true with a three-minute delay and the client sets
    // no gc stanza, so it DELETED host-only images three minutes after the last
    // task using them ended. There was nowhere to pull them back from, so the
    // next task failed to resolve the reference -- intermittently, since a task
    // that ran while the image was still there succeeded. CHECK_DB passed once
    // and failed every attempt after, with nothing about the pipeline changed.
    //
    // With ghcr behind it, Nomad can re-pull and the GC is harmless. It also
    // makes an image tag mean something to somebody else, which is what an image
    // tag pinning an analysis version is supposed to be for.
    container_registry = System.getenv('MTB_REGISTRY') ?: 'ghcr.io/abhi18av-phd-projects/mtb-resistotyper-ml-pipeline'
    // The FE image moved to carry check_integrity.py, which had to leave bin/
    // to avoid the s5cmd staging path. Tagged separately from the causal image
    // for the same reason the H2O image is: an image tag pins an analysis
    // version, so it should only move when that version does.
    container_tag      = 'v0.2.0'
    fe_container_tag   = 'v0.4.0'
    // The H2O image is tagged separately because it moves for reasons the other
    // two do not: it now carries the MLflow client, and bumping the shared tag
    // would falsely claim the FE and causal images had changed too. An image tag
    // pins the analysis version, so it should only move when that version does.
    h2o_container_tag  = 'v0.3.0'
    java_home     = System.getenv('JAVA_HOME') ?: '/usr/local/opt/openjdk'

    // Optional publication artefact: one DuckDB holding the marts, the causal
    // selections and their provenance — the state of the data after feature
    // engineering and before training. Nothing in the pipeline reads it. It
    // exists so that state can be deposited somewhere citable as a single
    // self-contained file. Off unless named:
    //   --create_duckdb mtb-resistotyper-fe-v1.duckdb
    create_duckdb = null

    // The other direction: start from a published DuckDB instead of a compendium.
    // Set it and the run skips database assembly, feature engineering and causal
    // selection entirely, unpacking those results from the deposit and going
    // straight to training. This is how a reader continues the work without the
    // twelve hours, the cluster, or the compendium.
    //   --from_duckdb mtb-resistotyper-fe-v1.duckdb
    from_duckdb     = null
    from_duckdb_arm = null      // restrict to one campaign arm, if it holds several

    skip_db_check = false
    // Worker jobs are removed from Nomad when they finish. Right for a healthy
    // cluster, wrong the moment something fails, because the failure is removed
    // with the job.
    nomad_delete_on_completion = true

    // --- scope --------------------------------------------------------------
    drugs    = 'RIF,INH,EMB,MXF,LEV,ETH,KAN,AMI,BDQ,LZD,CFZ'
    lineages = 'lineage1,lineage2,lineage3,lineage4'

    // --- feature engineering ------------------------------------------------
    // The point of the pipeline. Flat names so they work as ordinary CLI flags:
    //     --fe_top_n 2000 --fe_mutation_selector chi2 --fe_fold_strategy lineage
    //
    // To sweep several configurations against identical downstream folds, pass
    // --fe_configs <file.csv|.json> instead; each row/object becomes one mart.
    fe_name              = 'default'
    fe_mutation_selector = 'top_n'        // top_n | chi2 | mi | all
    fe_top_n             = 1000
    fe_max_carrier_frac  = 0.95
    fe_min_carrier_count = 10
    fe_gene_level_flags  = true
    fe_fold_strategy     = 'stratified'   // stratified | lineage | country
    fe_n_folds           = 5

    fe_configs           = null           // optional sweep

    // --- optional FE step chains -------------------------------------------
    // Comma-separated chains; a step may carry parameters as name:k=v;k=v.
    // Named for the LABEL BOUNDARY rather than the layers, because which side a
    // step runs on is what decides whether its number is honest. The registry
    // refuses a misplacement rather than trusting the operator.
    //   python -m analysis.scripts.fe_steps.run_step --list
    fe_pre_steps         = ''   // label-free: universe filters, annotations, derived cols
    fe_fold_steps        = ''   // label-using: association ranking and friends

    // Inside the repository, not beside it. A pipeline pulled from a URL has no
    // sibling directories, so a path that escapes projectDir resolves to nothing on
    // any machine but the one it was written on. 146 kB is worth carrying.
    gene_annotations     = "${projectDir}/assets/gene_annotations.parquet"
    experiment           = 'adhoc'

    candidate_level = 'mutation'           // mutation | gene
    // Candidates entering the concordance vote. Null = causal.py's default (300).
    candidate_pool_size = null

    // --- training -----------------------------------------------------------
    // --- experiment tracking -------------------------------------------------
    // Empty by default: tracking is a convenience, and a pipeline that fails
    // because a dashboard is unreachable has its priorities backwards. Set it to
    // the deployed server to record runs as they happen:
    //   --mlflow_uri https://mlflow.example.org   (or set MTB_MLFLOW_URI)
    mlflow_uri        = System.getenv('MTB_MLFLOW_URI') ?: null
    mlflow_experiment = 'mtb-resistotyper-ml/h2o'

    h2o_entrypoint    = 'train_h2o_stacked'
    h2o_feature_set   = 'concordant'
    h2o_runtime_secs  = 900
    // AUC weights both classes equally; AUCPR is the honest choice where
    // resistance is rare (BDQ, LZD, CFZ sit around 1-5%), because a classifier
    // that never predicts R still scores well on AUC there.
    h2o_sort_metric      = 'AUC'
    h2o_balance_classes  = false
}

process {
    errorStrategy = { task.exitStatus in [130, 137, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // `cpus` is advisory: the local executor schedules by it but does not
    // constrain the process, and econml/sklearn default to n_jobs = -1. On a
    // 48-core host that let one selection take ~45 cores while its sibling ran
    // on one, so two concurrent tasks were not two tasks -- they were one task
    // and a straggler. With 44 selections in a sweep that is thrashing, not
    // parallelism. Pin the maths libraries to what the task was actually given.
    beforeScript = { "export OMP_NUM_THREADS=${task.cpus} " +
                     "MKL_NUM_THREADS=${task.cpus} " +
                     "OPENBLAS_NUM_THREADS=${task.cpus} " +
                     "NUMEXPR_NUM_THREADS=${task.cpus} " +
                     "JOBLIB_MAX_NUM_THREADS=${task.cpus} " +
                     // BLAS threads and joblib WORKERS are different things.
                     // Pinning OMP_NUM_THREADS alone still let econml's
                     // n_jobs = -1 spawn one loky worker per core -- 94 processes
                     // across two tasks on a 48-core host. loky reads its own
                     // variable, so it needs its own pin.
                     "LOKY_MAX_CPU_COUNT=${task.cpus}" }

    // Default to the small image; the heavier labels override below.
    container = "${params.container_registry}/mtb-fe:${params.fe_container_tag}"

    withLabel: light    { cpus = 1;  memory = 2.GB;  time = '30m' }
    withLabel: io_heavy { cpus = 2;  memory = 8.GB;  time = '2h'  }
    withLabel: mart     { cpus = 2;  memory = 8.GB;  time = '1h'  }

    // The expensive stage: 11 drugs x 4 lineages of EBM + causal forest +
    // refutation. This is what the pipeline exists to distribute.
    withLabel: select   { cpus = 6;  memory = 16.GB; time = '6h'
                          container = "${params.container_registry}/mtb-causal:${params.container_tag}" }
    withLabel: evaluate { cpus = 4;  memory = 8.GB;  time = '2h'
                          container = "${params.container_registry}/mtb-causal:${params.container_tag}" }

    // H2O boots its own JVM per task; the heap is derived from this memory.
    withLabel: jvm      { cpus = 4;  memory = 16.GB; time = '4h'
                          container = "${params.container_registry}/mtb-h2o:${params.h2o_container_tag}" }
}

profiles {
    // Local development: no containers, the venvs on this machine.
    standard {
        process.executor  = 'local'
        docker.enabled    = false
        process.container = null
    }

    // Containers, wherever they run. Each image carries analysis/ at /opt/mtb on
    // PYTHONPATH, so a process calls a plain `python` rather than a path that
    // exists on exactly one laptop.
    containers {
        docker.enabled       = true
        params.python        = 'python'
        params.python_causal = 'python'
        params.python_h2o    = 'python3.11'
        params.project_root  = '/opt/mtb'
    }

    // Dogfooding nf-nomad on the abc cluster.
    // The abc cluster. Containers are not optional here: a Nomad task has
    // neither this repository nor these virtual environments.
    //
    // The plugin is pinned in the pipeline rather than left to the submitting
    // client. abc-cli defaults to 0.4.4; 0.5.0-edge6 adds the podman driver fix
    // and targets Nextflow 26.04.3, which is the head image. Pinning here means
    // a run submitted any other way gets the same executor, so the two cannot
    // drift and a result cannot depend on who launched it.
    //
    // workDir sits in the GROUP-shared pipeline area, not in a per-user or
    // per-project one. That is the whole point of ADR-0060's taxonomy: the
    // resume session UUID keys off this path, so a colleague re-running the
    // same pipeline reuses the work this run does rather than repeating it.
    nomad {
        process.executor     = 'nomad'

        // One node, shared with eighteen of the platform's own services. Left
        // unbounded, Nextflow submitted all five 6-CPU selections at once and
        // Nomad answered "cpu exhausted on 1 node(s)". That arrives as
        // "[NOMAD] Cannot determine exit status" — a PLACEMENT failure wearing a
        // task failure's clothes — so Nextflow retried, and each retry added
        // another blocked allocation to the queue that was already full.
        //
        // Bounding submission makes tasks wait in Nextflow, where waiting is
        // free, instead of queueing as blocked reservations on the node.
        executor.queueSize = 3
        // 0.5.0-edge7 and s5cmd 0.1.8 carry the fixes for the two bugs that cost a day
// here: nf-nomad no longer reads an unread exit code as success (#148), and
// nf-nomad-s5cmd reads getBinDirs from the TaskProcessor rather than the
// Session (#7), so a pipeline with a bin/ directory no longer fails its
// allocations. Both were reported from this project.
        plugins              = ['nf-nomad@0.5.0-edge7', 'nf-nomad-s5cmd@0.1.8']
        docker.enabled       = true
        params.python        = 'python'
        params.python_causal = 'python'
        params.python_h2o    = 'python3.11'
        params.project_root  = '/opt/mtb'
        params.db            = params.db ?: "${params.references}/cryptic/${params.db_name ?: 'cryptic.duckdb'}"
        params.outdir        = "${params.user_results}/${params.experiment}"

        workDir              = "${params.pipeline_root}/workdir"

        // MinIO, not AWS. Credentials come from the environment so nothing
        // secret is committed; source them from the abc context with
        //   eval "$(abc data credentials --export)"
        // or set them by hand from ~/.abc/config.yaml. Use the API port :9000,
        // never the console :9001.
        aws {
            accessKey = System.getenv('AWS_ACCESS_KEY_ID')
            secretKey = System.getenv('AWS_SECRET_ACCESS_KEY')
            client {
                endpoint          = System.getenv('ABC_MINIO_ENDPOINT')
                s3PathStyleAccess = true
            }
        }
        nomad.client.address = System.getenv('NOMAD_ADDR')
        // The group's own namespace, not the platform apps one. 'abc-apps' is for
        // researcher-deployed services; pipeline and batch work belongs in the
        // group namespace, which is where quota and priority are set.
        nomad.jobs.namespace = System.getenv('NOMAD_NAMESPACE') ?: System.getenv('MTB_NOMAD_NAMESPACE') ?: params.group_bucket
        // Deleting a worker job on completion also deletes the evidence when it
        // FAILS: the allocation, its events and its logs go with the job, leaving
        // a head that reports a missing output and a work dir holding only
        // .command.sh. Keep them while debugging.
        //   --param nomad_delete_on_completion=false
        nomad.jobs.deleteOnCompletion = params.nomad_delete_on_completion
    }

    // A validation profile has to be fast enough to actually be run before a
    // real one. The pool dominates selection wall time -- every candidate costs
    // a CATE fit plus a refutation pass -- so 25 turns a half-hour smoke test
    // into a couple of minutes while still exercising every process.
    test {
        params.drugs               = 'RIF'
        params.lineages            = 'lineage2'
        params.candidate_pool_size = 25
        params.fe_top_n            = 200
        params.h2o_runtime_secs    = 60
    }
}

report  { enabled = true; file = "${params.outdir}/reports/report.html";   overwrite = true }
timeline{ enabled = true; file = "${params.outdir}/reports/timeline.html"; overwrite = true }
trace   { enabled = true; file = "${params.outdir}/reports/trace.txt";     overwrite = true }
dag     { enabled = true; file = "${params.outdir}/reports/dag.mmd";       overwrite = true }

manifest {
    name            = 'mtb-resistotyper-ml'
    description     = 'Feature engineering and model training for M. tuberculosis resistance prediction'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}
