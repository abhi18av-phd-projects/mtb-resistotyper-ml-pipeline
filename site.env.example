# Deployment-specific settings. Copy to `site.env` and edit; site.env is
# gitignored.
#
#     cp site.env.example site.env && $EDITOR site.env
#     set -a; . ./site.env; set +a
#
# Everything here describes WHERE the pipeline runs, never WHAT it computes.
# What it computes lives in experiments/*.yml, which is why those files carry no
# hostnames, buckets or endpoints: an experiment definition that embeds one
# site's storage layout cannot be re-run anywhere else, and the point of
# committing an experiment is that somebody else can.

# --- object storage ---------------------------------------------------------
# The group's bucket. A project is a PREFIX inside it, never a bucket of its
# own: the shared pipeline cache and the workbench home are both keyed on the
# group bucket, so a project bucket silently opts out of both.
MTB_GROUP_BUCKET=su-example-group

# The S3 endpoint the pipeline HEAD should use. Set this to the INTERNAL address
# when the head runs on the same network as the object store. Sending it to a
# public edge instead measured 0.4 MB/s against 85 MB/s on the same host, on a
# ten gigabyte input, which is the difference between ninety seconds and not
# finishing.
MTB_S3_ENDPOINT=http://minio.internal:9000

# --- scheduler --------------------------------------------------------------
MTB_NOMAD_NAMESPACE=su-example-group
# The node pool workers must land in. If the context default names a pool with
# no clients, jobs are accepted and never placed, reporting "No nodes were
# eligible for evaluation" — which reads as a constraint problem rather than an
# empty pool.
MTB_HEAD_POOL=platform
MTB_WORKER_POOL=platform

# --- abc CLI ----------------------------------------------------------------
# Per-command context. Never run `abc auth context use`: the active context is
# global mutable state shared by every concurrent session.
ABC_CLI_CONTEXT=my-context

# --- experiment tracking (optional) -----------------------------------------
# Empty disables tracking. A pipeline that fails because a dashboard is
# unreachable has its priorities backwards, so this is opt-in and non-fatal.
MTB_MLFLOW_URI=

# --- container images -------------------------------------------------------
MTB_REGISTRY=ghcr.io/abhi18av-phd-projects/mtb-resistotyper-ml-pipeline

# --- MLflow deployment (only if you deploy the tracking server) -------------
MTB_PROJECT=my-group
MTB_BUILD_HOST=my-build-host
MLFLOW_TAG=v0.3.0
# MLflow 3.x refuses an unrecognised Host header and blocks cross-origin POSTs,
# and every UI data call is a POST. The failure is asymmetric: /health is exempt
# and answers 200, so the platform reports the app healthy while a browser gets
# 403. Both lists must name the hosts the UI is actually reached on.
MTB_MLFLOW_HOSTS=mlflow.example.org,localhost:*,127.0.0.1:*
MTB_MLFLOW_ORIGINS=https://mlflow.example.org,http://localhost:*
