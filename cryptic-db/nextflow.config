/*
 * cryptic-db — CRyPTIC release tables into a reproducible DuckDB.
 */

params {
    cryptic_src    = null       // cryptic-tables-vX.Y.Z/
    release        = null       // defaults to the version in the source dir name
    outdir         = 'cryptic-db'
    export_parquet = true
    // Blocking is scoped to the tables the marts read. --strict also fails on
    // peripheral orphans (plate readings, citizen-science classifications).
    strict_integrity = false
    make_slim      = false      // opt-in reduced copy; see modules/make_slim

    pipeline_dir   = "${projectDir}"
    scripts_dir    = "${projectDir}/../analysis/scripts/build_cryptic_db"
    python         = "${projectDir}/../.pixi/envs/default/bin/python"
}

process {
    errorStrategy = { task.exitStatus in [130, 137, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: light      { cpus = 1; memory = 2.GB;  time = '30m' }
    withLabel: load       { cpus = 2; memory = 8.GB;  time = '1h'  }
    // mutations and variants are the large loads, and the assembly and parquet
    // export both touch every table.
    withLabel: load_large { cpus = 4; memory = 24.GB; time = '3h'  }
}

profiles {
    standard { process.executor = 'local' }
    nomad {
        process.executor = 'nomad'
        nomad.client.address = System.getenv('NOMAD_ADDR')
        nomad.jobs.namespace = System.getenv('NOMAD_NAMESPACE') ?: 'default'
        nomad.jobs.deleteOnCompletion = true
    }
}

report  { enabled = true; file = "${params.outdir}/reports/report.html";   overwrite = true }
timeline{ enabled = true; file = "${params.outdir}/reports/timeline.html"; overwrite = true }
trace   { enabled = true; file = "${params.outdir}/reports/trace.txt";     overwrite = true }
dag     { enabled = true; file = "${params.outdir}/reports/dag.mmd";       overwrite = true }

manifest {
    name            = 'cryptic-db'
    description     = 'CRyPTIC release tables into a reproducible, checksummed DuckDB'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}
